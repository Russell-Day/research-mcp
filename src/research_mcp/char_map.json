{
  "_about": "The one mapping table for textclean.py. Edit only after review of a char-mapping report; reports never edit this file. Each entry covers 'from'..'through' (inclusive, 'through' optional). action: strip = remove; space = a normal space; map = replace with 'to'; keep = leave alone (documents a deliberate choice). Characters not listed are kept.",
  "version": 1,
  "entries": [
    {"from": "U+0000", "through": "U+0008", "action": "strip", "reason": "C0 control characters"},
    {"from": "U+000B", "action": "keep", "reason": "vertical tab: Word's and PowerPoint's manual line break (Shift+Enter)"},
    {"from": "U+000C", "action": "strip", "reason": "form feed (each MCP writes its own page breaks)"},
    {"from": "U+000E", "through": "U+001F", "action": "strip", "reason": "C0 control characters"},
    {"from": "U+007F", "through": "U+009F", "action": "strip", "reason": "DEL and C1 control characters"},
    {"from": "U+00A0", "action": "space", "reason": "no-break space: becomes a regular space (pass keep to hold one)"},
    {"from": "U+00AD", "action": "strip", "reason": "soft hyphen (invisible)"},
    {"from": "U+034F", "action": "strip", "reason": "combining grapheme joiner (invisible)"},
    {"from": "U+061C", "action": "strip", "reason": "Arabic letter mark (bidi control)"},
    {"from": "U+115F", "through": "U+1160", "action": "strip", "reason": "Hangul fillers (invisible)"},
    {"from": "U+1680", "action": "space", "reason": "Ogham space mark"},
    {"from": "U+17B4", "through": "U+17B5", "action": "strip", "reason": "Khmer inherent vowels (invisible)"},
    {"from": "U+180E", "action": "strip", "reason": "Mongolian vowel separator (invisible)"},
    {"from": "U+2000", "through": "U+200A", "action": "space", "reason": "typographic spaces (en, em, thin, hair, figure, ...)"},
    {"from": "U+200B", "action": "strip", "reason": "zero-width space"},
    {"from": "U+200C", "action": "strip", "reason": "zero-width non-joiner"},
    {"from": "U+200D", "action": "strip", "reason": "zero-width joiner (kept inside emoji sequences)"},
    {"from": "U+200E", "through": "U+200F", "action": "strip", "reason": "left-to-right / right-to-left marks"},
    {"from": "U+2010", "through": "U+2011", "action": "map", "to": "-", "reason": "hyphen / non-breaking hyphen -> keyboard hyphen"},
    {"from": "U+2012", "action": "keep", "reason": "figure dash: rare, left for review"},
    {"from": "U+2013", "through": "U+2014", "action": "keep", "reason": "en and em dashes: manuscript style"},
    {"from": "U+2018", "through": "U+2019", "action": "keep", "reason": "curly single quotes: manuscript style"},
    {"from": "U+201B", "action": "map", "to": "\u2019", "reason": "reversed single quote -> right single quote"},
    {"from": "U+201C", "through": "U+201D", "action": "keep", "reason": "curly double quotes: manuscript style"},
    {"from": "U+201F", "action": "map", "to": "\u201d", "reason": "reversed double quote -> right double quote"},
    {"from": "U+2026", "action": "keep", "reason": "ellipsis: Word autocorrects ... to it"},
    {"from": "U+2028", "action": "map", "to": "\n", "reason": "line separator -> the MCP's own line break"},
    {"from": "U+2029", "action": "map", "to": "\n", "reason": "paragraph separator -> the MCP's own break"},
    {"from": "U+202A", "through": "U+202E", "action": "strip", "reason": "bidi embedding and override controls"},
    {"from": "U+202F", "action": "space", "reason": "narrow no-break space"},
    {"from": "U+205F", "action": "space", "reason": "medium mathematical space (outside equations)"},
    {"from": "U+2060", "action": "strip", "reason": "word joiner"},
    {"from": "U+2061", "through": "U+2064", "action": "keep", "reason": "invisible math operators (function application, times, separator, plus): math"},
    {"from": "U+2066", "through": "U+2069", "action": "strip", "reason": "bidi isolate controls"},
    {"from": "U+206A", "through": "U+206F", "action": "strip", "reason": "deprecated format characters"},
    {"from": "U+2190", "through": "U+21FF", "action": "keep", "reason": "arrows: Word autocorrects -> to them"},
    {"from": "U+2212", "action": "keep", "reason": "minus sign: math"},
    {"from": "U+3000", "action": "space", "reason": "ideographic space"},
    {"from": "U+3164", "action": "strip", "reason": "Hangul filler (invisible)"},
    {"from": "U+FE00", "through": "U+FE0F", "action": "keep", "reason": "variation selectors (emoji presentation)"},
    {"from": "U+FEFF", "action": "strip", "reason": "byte-order mark / zero-width no-break space"},
    {"from": "U+FF01", "through": "U+FF5E", "action": "map", "to": "ascii", "reason": "fullwidth ASCII -> ASCII"},
    {"from": "U+FFA0", "action": "strip", "reason": "halfwidth Hangul filler (invisible)"},
    {"from": "U+FFF9", "through": "U+FFFB", "action": "strip", "reason": "interlinear annotation controls"},
    {"from": "U+1D173", "through": "U+1D17A", "action": "strip", "reason": "musical symbol format controls (invisible)"},
    {"from": "U+E0000", "through": "U+E007F", "action": "strip", "reason": "Unicode tag characters (hidden text; kept inside emoji flag sequences)"}
  ]
}
